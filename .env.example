# Copy to .env and adjust. All values are optional.

# Port the app is published on (http://localhost:3000)
APP_PORT=3000

# Database password (only takes effect when the database is first created)
POSTGRES_PASSWORD=change-me
# Database user and name (defaults: atrium)
# POSTGRES_USER=atrium
# POSTGRES_DB=atrium

# Set to true when serving over HTTPS behind a reverse proxy
SECURE_COOKIES=false
# The address people use to reach Atrium (e.g. https://atrium.example.com), used in links sent by email.
PUBLIC_URL=
# Whether webhooks and AI service addresses may point at the local network (true for self-hosting with a
# local Ollama or n8n). SET TO false ON A SHARED OR HOSTED SERVER (the admin panel warns while it's on).
ALLOW_PRIVATE_URLS=true
# Which proxies may pass on the visitor's real address (X-Forwarded-For), used for rate limits. Empty (the
# default since 1.11.3): none, which is right when people reach the app's port directly. Running Caddy, nginx
# or Cloudflare Tunnel in front? Set it to that proxy's address, for example loopback (same machine),
# 172.16.0.0/12 (another container on the Docker network) or 203.0.113.7. true: any (only when every request
# goes through a proxy you run). Without it, everyone behind your proxy shares one set of limits.
TRUST_PROXY=
# Use a ready-made image instead of building (then: docker compose pull app && docker compose up -d --no-build).
# ATRIUM_IMAGE=ghcr.io/taidies/atrium:latest

# Largest allowed upload, in megabytes
MAX_UPLOAD_MB=25

# Largest export .zip that can be imported, in megabytes
MAX_IMPORT_MB=1024

# Time zone for repeating tasks (they reset at midnight in this zone)
TZ=UTC

# How many document conversions run at once
CONVERT_PARALLEL=2

# Email (optional): sign in and sign up with a code sent by email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=
# SMTP_SECURE=false
# MAIL_FROM=Atrium <you@example.com>
# New accounts must confirm their email (needs email set up)
# REQUIRE_EMAIL_VERIFICATION=false

# Admin panel (accounts, sign-ups, AI for everyone). Only reachable from this machine by default.
# ADMIN_PORT=3001
# Leave empty to have one made on first start (printed in the log, changeable in the panel).
# ADMIN_PASSWORD=

# The app's name (sign-in page, emails, the apps)
# APP_NAME=Atrium

# Meetings: where calls find each other. The default (a public STUN server) works on one network;
# across the internet add a TURN server, as JSON:
# RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"atrium","credential":"secret"}]

# Log detail: fatal, error, warn, info, debug
# LOG_LEVEL=info

# Thin out page history older than this many days (the newest 10 versions of each page are always kept).
# Empty or 0 (the default since 1.11.3): keep all history. Must be a whole number.
# HISTORY_DAYS=90

# How long one AI answer may take while a request waits for it, in milliseconds. Keep it under your
# reverse proxy's limit (Cloudflare: 100 seconds). Longer AI work runs in the background.
# AI_TIMEOUT_MS=90000
