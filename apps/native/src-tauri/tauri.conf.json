{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atrium",
  "version": "1.11.2",
  "identifier": "io.github.taidies.atrium",
  "build": {
    "frontendDist": "../../../web/dist",
    "beforeBuildCommand": "npm --prefix ../../web run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http:",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: wss: ws:",
        "frame-src": "'self' blob: data: https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MjZEQzI3QTlBQTVBRTgKUldUb1dxcXBKOXdtMVZLRmZjNEp4c0QxWjRKTmxlUWFlWG8zdGpqVlVtWjFmOUVQYUgxT1R0RTAK",
      "endpoints": [
        "https://github.com/TaiDies/atrium/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
